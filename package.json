{
  "name": "kdl-prompt-studio",
  "version": "1.0.0",
  "description": "Générateur de prompts ultra-précis et optimisés pour différentes IA. 100% local.",
  "private": true,
  "type": "module",
  "author": "KDL TECH — Karim DeLucia",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node src/server.cjs",
    "build:exe": "npm run build && pkg ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "main": "src/server.cjs",
  "bin": "src/server.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "scripts": [
      "src/**/*.cjs"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64",
      "node22-macos-x64",
      "node22-macos-arm64"
    ],
    "outputPath": "dist-exe"
  }
}
